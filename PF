-- =====================================================================
-- 3. LINE CLIPPING ALGORITHM
-- =====================================================================
-- Finds the exact 3D point on the screen edge where the tracer crosses the viewport boundary
local function getClippedPoint(pOn, pOff)
    local low = 0
    local high = 1
    local bestP = pOn
    local bestSP = nil
    
    for i = 1, 5 do
        local mid = (low + high) * 0.5
        local p_mid = pOn:Lerp(pOff, mid)
        local sp, onScreen = MatchaWorldToScreen(p_mid)
        if onScreen then
            bestP = p_mid
            bestSP = sp
            low = mid
        else
            high = mid
        end
    end
    return bestSP or MatchaWorldToScreen(bestP)
end

