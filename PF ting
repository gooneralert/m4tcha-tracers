local function getGun(folder)
    local now = tick()
    local name = folder.Name
    local last = lastCacheTime[name]
    
    if not last or (now - last > 0.5) then
        lastCacheTime[name] = now
        local found = "Unknown"
        
        for _, child in next, folder:GetChildren() do
            if child.ClassName == "Model" then
                local g = child.Name:gsub("Main", ""):gsub("^%s+", ""):gsub("%s+$", "")
                if g ~= "" then
                    found = g
                    break
                end
            end
        end
        gunCache[name] = found
    end
    
    return gunCache[name] or "Unknown"
end

local function loadEsp()
    if not _G.ESP_Utility then
        local ok, src = pcall(game.HttpGet, game, "https://raw.githubusercontent.com/artxficial/matchastuff/main/esp_utility.lua")
        if ok and src then
            src = src:gsub("game%.Players%.LocalPlayer", 'game:GetService("Players").LocalPlayer')
            src = src:gsub("game%.Players", 'game:GetService("Players")')
            src = src:gsub('self:AddText%("Distance".-end%)', '')
            
            local fn = loadstring(src)
            if fn then fn() end
        end
    end
    
    local ESP = _G.ESP_Utility or ESP_Utility
    if not ESP then return nil end
    
    if not ESP._patched then
        ESP._patched = true
        
        pcall(function()
            ESP._GetDistance = function() return 0 end
            ESP._IsAlive = function(self)
                return self.Object and self.Object.Parent ~= nil
            end

            local oldUpdate = ESP._Update
            ESP._Update = function(self)
                if not getmetatable(self) or not self._IsAlive or not self._DetermineVisibility then return end
                local ok = pcall(oldUpdate, self)
                if not ok then
                    pcall(function() self:Destroy() end)
                end
            end

            local oldDestroy = ESP.Destroy
            ESP.Destroy = function(self)
                pcall(function()
                    if ESP.TrackersToUpdate and self.Object then
                        ESP.TrackersToUpdate[self.Object] = nil
                        if self.Object.Address then
                            ESP.TrackersToUpdate[self.Object.Address] = nil
                        end
                    end
                end)
                
                pcall(function()
                    if self.Drawings then
                        for _, d in pairs(self.Drawings) do
                            if type(d) == "table" and d.Drawing then
                                pcall(function() d.Drawing:Remove() end)
                            elseif type(d) == "table" then
                                pcall(function() d:Remove() end)
                            else
                                pcall(function() d:Remove() end)
                            end
                        end
                    end
                end)
                
                pcall(oldDestroy, self)
            end
        end)
    end
    return ESP
end

