local function addTracer(p1, p2)
    if #activeTracers >= 20 then
        table.remove(activeTracers, 1)
    end
    table.insert(activeTracers, {
        start = p1,
        target = p2,
        t = tick()
    })
end

local function drawTracers()
    local now = tick()
    local drawIdx = 0

    if not cfg.enabled then 
        for i = 1, lastDrawCount do
            local d = drawings[i]
            if d then d.Visible = false end
        end
        lastDrawCount = 0
        return 
    end

    for i = #activeTracers, 1, -1 do
        local tr = activeTracers[i]
        if (now - tr.t) >= cfg.fadeTime then
            table.remove(activeTracers, i)
        end
    end

    for tIdx = 1, #activeTracers do
        local tr = activeTracers[tIdx]
        local age = now - tr.t
        local alpha = math.max(0, 1 - age / cfg.fadeTime)

        if alpha > 0.01 then
            local dir, right, trueUp, lenFactor, freqRatio = nil, nil, nil, 1.0, 1.0
            local delta = tr.target - tr.start
            local dist = delta.Magnitude
            if dist > 0 then
                dir = delta / dist
                local up = math.abs(dir.Y) > 0.99 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
                right = dir:Cross(up).Unit
                trueUp = right:Cross(dir).Unit
                lenFactor = math.clamp(dist / 150, 0.05, 0.75)
                freqRatio = math.clamp(dist / 250, 0.15, 1.6)
            end

            local segments = cfg.segments or 5
            if cfg.trailType == "solid" then
                segments = 1
            elseif cfg.trailType == "Rope kinda?" then
                segments = math.clamp(math.floor(12 * freqRatio), 8, 24)
            end

            local function getOffset(t)
                if not right or t <= 0 or t >= 1 then return Vector3.zero end
                local env = math.sin(t * math.pi)
                local stretch = (1 - t * t * 0.65)
                local ax = t * (5 * freqRatio) * stretch - now * 10 + tIdx
                local ay = t * (11 * freqRatio) * stretch + now * 12 - tIdx
                local wx = math.sin(ax) * 1.5 + math.cos(ax * 2.2) * 0.4
                local wy = math.cos(ay) * 1.5 + math.sin(ay * 2.2) * 0.4
                local scale = (1.5 + cfg.thickness * 0.5) * env * lenFactor
                return right * (wx * scale) + trueUp * (wy * scale)
            end

            for sIdx = 1, segments do
                local t1 = (sIdx - 1) / segments
                local t2 = sIdx / segments

                local p1 = tr.start:Lerp(tr.target, t1)
                local p2 = tr.start:Lerp(tr.target, t2)

                if cfg.trailType == "Rope kinda?" then
                    p1 = p1 + getOffset(t1)
                    p2 = p2 + getOffset(t2)
                end

                local sp1, on1 = w2s(p1)
                local sp2, on2 = w2s(p2)

                local canDraw = false
                local fsp1, fsp2

                if on1 and on2 then
                    fsp1 = Vector2.new(sp1.X, sp1.Y)
                    fsp2 = Vector2.new(sp2.X, sp2.Y)
                    canDraw = true
                elseif on1 and not on2 then
                    local cl = clipPoint(p1, p2)
                    if cl then
                        fsp1 = Vector2.new(sp1.X, sp1.Y)
                        fsp2 = Vector2.new(cl.X, cl.Y)
                        canDraw = true
                    end
                elseif not on1 and on2 then
                    local cl = clipPoint(p2, p1)
                    if cl then
                        fsp1 = Vector2.new(cl.X, cl.Y)
                        fsp2 = Vector2.new(sp2.X, sp2.Y)
                        canDraw = true
                    end
                else
                    local pMid = p1:Lerp(p2, 0.5)
                    local spMid, onMid = w2s(pMid)
                    if onMid then
                        local cl1 = clipPoint(pMid, p1)
                        local cl2 = clipPoint(pMid, p2)
                        if cl1 and cl2 then
                            fsp1 = Vector2.new(cl1.X, cl1.Y)
                            fsp2 = Vector2.new(cl2.X, cl2.Y)
                            canDraw = true
                        end
                    end
                end

                if canDraw then
                    local tt = cfg.trailType
                    local col = sampleColors(t1)
                    local th = cfg.thickness
                    local isNeon = tt == "neon"
                    local neonA

                    if tt == "pulse" then
                        th = cfg.thickness * (1 + 0.4 * math.sin(now * 12 + tIdx + sIdx * 0.2))
                    elseif tt == "rainbow" then
                        col = hsv((now * 0.5 + t1 * 0.5) % 1, 0.85, 1)
                    elseif tt == "flicker" then
                        col = sampleColors(math.sin(now * 15 + t1 * math.pi) * 0.5 + 0.5)
                    elseif tt == "neon" then
                        neonA = alpha * (0.85 + 0.15 * math.sin(now * 8 + tIdx * 0.5))
                    end

                    if tt == "Rope kinda?" then
                        local fade = (1 - t1) * 0.9 + 0.1
                        local eAlpha = alpha * fade * (0.8 + 0.2 * math.sin(now * 25 + tIdx * 10 + sIdx))
                        local eTh = cfg.thickness * fade

                        local layers = {
                            { eTh * 4.5, eAlpha * 0.2 },
                            { eTh * 1.8, eAlpha * 0.6 },
                            { eTh * 0.7, eAlpha },
                        }
                        for _, l in ipairs(layers) do
                            drawIdx = drawIdx + 1
                            local d = getLine(drawIdx)
                            if d then
                                d.From = fsp1
                                d.To = fsp2
                                d.Color = col
                                d.Thickness = l[1]
                                d.Transparency = l[2]
                                d.ZIndex = 5
                                d.Visible = true
                            end
                        end
                    elseif isNeon then
                        local layers = {
                            { cfg.thickness * 4.5, neonA * 0.2 },
                            { cfg.thickness * 1.8, neonA * 0.7 },
                            { cfg.thickness * 0.7, neonA },
                        }
                        for _, l in ipairs(layers) do
                            drawIdx = drawIdx + 1
                            local d = getLine(drawIdx)
                            if d then
                                d.From = fsp1
                                d.To = fsp2
                                d.Color = col
                                d.Thickness = l[1]
                                d.Transparency = l[2]
                                d.ZIndex = 5
                                d.Visible = true
                            end
                        end
                    else
                        drawIdx = drawIdx + 1
                        local d = getLine(drawIdx)
                        if d then
                            d.From = fsp1
                            d.To = fsp2
                            d.Color = col
                            d.Thickness = th
                            d.Transparency = alpha
                            d.ZIndex = 5
                            d.Visible = true
                        end
                    end
                end
            end
        end
    end
    
    for i = drawIdx + 1, lastDrawCount do
        local d = drawings[i]
        if d then d.Visible = false end
    end
    lastDrawCount = drawIdx
end

local function getIgnore()
    local list = {}
    if player.Character then table.insert(list, player.Character) end
    local cam = getCamera()
    if cam then table.insert(list, cam) end
    return list
end

local function isArm(inst)
    local cur = inst
    while cur and cur ~= game do
        local name = cur.Name:lower()
        if name:find("arm") or name:find("sleeve") or name:find("skintone") or name:find("hand") then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function getMuzzle()
    local cam = getCamera()
    if not cam then return nil end
    
    for _, child in ipairs(cam:GetChildren()) do
        if child.ClassName == "Model" then
            for _, part in ipairs(child:GetDescendants()) do
                if part and validParts[part.ClassName] and not isArm(part) then
                    if part:FindFirstChildOfClass("SpecialMesh") then
                        return part
                    end
                end
            end
        end
    end
    return nil
end

local currentMuzzle = nil
local lastMuzzleScan = 0

local function getOrigin(char)
    local now = tick()
    if not currentMuzzle or currentMuzzle.Parent == nil or (now - lastMuzzleScan > 0.5) then
        lastMuzzleScan = now
        currentMuzzle = getMuzzle() or (char and char:FindFirstChild("Head"))
    end
    return currentMuzzle
end

local function getAmmoLabel()
    if not player then return nil end
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local hud = gui:FindFirstChild("HudScreenGui")
    local main = hud and hud:FindFirstChild("Main")
    local disp = main and main:FindFirstChild("DisplayStatus")
    return disp and disp:FindFirstChild("TextMagCount")
end

local function shootTracer()
    local char = player.Character
    local origin = getOrigin(char)
    
    if origin and origin.Parent ~= nil then
        local okPos, pos = pcall(function() return origin.Position end)
        if not okPos or not pos then return end
        
        local maxDist = 1000
        local cf
        local okCF, cfVal = pcall(function() return origin.CFrame end)
        if okCF and cfVal then
            cf = cfVal
        else
            cf = CFrame.new(pos)
        end
        
        local dir = Vector3.new(0, 0, -maxDist)
        if cf then
            local okLook, look = pcall(function() return cf.LookVector end)
            if okLook and look then
                dir = look * maxDist
            end
        end
        
        local target = pos + dir
        pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = getIgnore()
            params.IgnoreWater = true
            local res = workspace:Raycast(pos, dir, params)
            if res then
                target = res.Position
            end
        end)
        
        addTracer(pos, target)
    end
end

local scannerThread = task.spawn(function()
    while true do
        getOrigin(player.Character)
        task.wait(0.5)
    end
end)

local function onStep()
    camera = getCamera()
    drawTracers()

    if not isrbxactive() then return end
    
    local lbl = getAmmoLabel()
    if lbl and lbl.Text then
        local clean = (lbl.Text:gsub("%s+", ""))
        local val = tonumber(clean)
        if val then
            if lastAmmo and val < lastAmmo then
                shootTracer()
            end
            lastAmmo = val
        else
            lastAmmo = nil
        end
    else
        lastAmmo = nil
    end
end

local renderConn = RunService.RenderStepped:Connect(onStep)

_G.MatchaTracerCleanup = function()
    if renderConn then 
        pcall(function() renderConn:Disconnect() end)
        renderConn = nil
    end
    
    if scannerThread then 
        pcall(task.cancel, scannerThread) 
        scannerThread = nil
    end
    
    gunEspOn = false
    if gunEspThread then
        pcall(task.cancel, gunEspThread)
        gunEspThread = nil
    end
    
    tagEspOn = false
    if tagEspThread then
        pcall(task.cancel, tagEspThread)
        tagEspThread = nil
    end
    
    if gunTrackers then
        for _, tr in next, gunTrackers do
            pcall(function() tr:Destroy() end)
        end
        table.clear(gunTrackers)
    end
    
    if tagTrackers then
        for _, tr in pairs(tagTrackers) do
            pcall(function() tr:Destroy() end)
        end
        table.clear(tagTrackers)
    end
    
    local ESP = _G.ESP_Utility or ESP_Utility
    if ESP and ESP.TrackersToUpdate then
        pcall(table.clear, ESP.TrackersToUpdate)
    end
    
    table.clear(gunCache)
    table.clear(lastCacheTime)
    currentMuzzle = nil
    
    if _G.MatchaTracerWindow then
        pcall(function() _G.MatchaTracerWindow:Destroy() end)
        _G.MatchaTracerWindow = nil
    end

    for _, d in pairs(drawings) do
        if d then pcall(function() d:Remove() end) end
    end
    table.clear(drawings)
    table.clear(activeTracers)
    lastDrawCount = 0
end
