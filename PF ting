local function clipPoint(p1, p2)
    local low, high = 0, 1
    local bestP = p1
    local bestSP = nil
    
    for i = 1, 5 do
        local mid = (low + high) * 0.5
        local pMid = p1:Lerp(p2, mid)
        local sp, onScreen = w2s(pMid)
        if onScreen then
            bestP = pMid
            bestSP = sp
            low = mid
        else
            high = mid
        end
    end
    return bestSP or w2s(bestP)
end

