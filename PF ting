-- Recursively zero all number and Vector3 fields in a table
local function zeroTable(t, depth)
    if type(t) ~= "table" then return end
    depth = depth or 4
    if depth <= 0 then return end

    for k, v in pairs(t) do
        local vt = type(v)
        if vt == "number" then
            t[k] = 0
        elseif vt == "table" then
            zeroTable(v, depth - 1)
        elseif typeof and typeof(v) == "Vector3" then
            t[k] = Vector3.zero
        end
    end
end

-- Apply all no-recoil modifications once
local function applyNoRecoilOnce()
    task.spawn(function()
        -- Zero top-level number fields one by one with delay
        local numberCache = getgc(numberKeys)
        for _, key in ipairs(numberKeys) do
            pcall(applygc, numberCache, key, 0)
        end

        -- Zero recoil / spring table contents with delay
        local containerCache = getgc(containerKeys)
        for _, entry in ipairs(containerCache) do
            if entry and entry.type == "table" then
                zeroTable(entry.value, 4)
            end
        end
    end)
end

